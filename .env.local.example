# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key -- SERVER SIDE ONLY. Never expose this in client code or commit it.
# Used by server actions / route handlers to read and write data on behalf of
# teachers (who authenticate with a kelompok PIN, not Supabase Auth).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random long string used to sign the teacher session cookie.
TEACHER_SESSION_SECRET=change-this-to-a-long-random-string
